<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <title>Che personaggio sei di KawaiiYamiShop?</title>
  <style>
    body {
      font-family: 'Comic Sans MS', cursive;
      background-color: #fff0f5;
      color: #333;
      text-align: center;
      padding: 20px;
    }
    .question {
      margin: 20px 0;
    }
    button {
      margin: 5px;
      padding: 10px 20px;
      border: none;
      background-color: #ffb6c1;
      color: #000;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
    }
    #result {
      margin-top: 30px;
    }
    img {
      width: 300px;
      max-width: 90%;
      border-radius: 15px;
    }
  </style>
</head>
<body>
  <h1>Che personaggio sei di KawaiiYamiShop?</h1>

  <div id="quiz">
    <div class="question">
      <p>Preferisci leggere un libro vicino a una candela o andare a una festa affollata?</p>
      <button onclick="answer('Tomoe')">Leggere un libro</button>
      <button onclick="answer('Kitsu')">Andare a una festa</button>
    </div>
    <div class="question">
      <p>Ti piacciono di più i fiori o le stelle?</p>
      <button onclick="answer('Yume')">Fiori</button>
      <button onclick="answer('Miyon')">Stelle</button>
    </div>
    <div class="question">
      <p>Come ti descriveresti?</p>
      <button onclick="answer('Miyun')">Sensibile e tranquilla</button>
      <button onclick="answer('Iaia')">Intuitiva e misteriosa</button>
    </div>
    <div class="question">
      <p>Preferisci stare sola a riflettere o chiacchierare con chi ami?</p>
      <button onclick="answer('Nyu')">Sola a riflettere</button>
      <button onclick="answer('Dodo')">Chiacchierare</button>
    </div>
    <div class="question">
      <p>Hai un lato ribelle o romantico?</p>
      <button onclick="answer('Kurob')">Ribelle</button>
      <button onclick="answer('Anya')">Romantico dark</button>
    </div>
    <div class="question">
      <button onclick="showResult()">Scopri il tuo personaggio!</button>
    </div>
  </div>

  <div id="result"></div>

  <script>
    const answers = {};
    function answer(character) {
      answers[character] = (answers[character] || 0) + 1;
    }

    function showResult() {
      const resultDiv = document.getElementById('result');
      const quizDiv = document.getElementById('quiz');
      quizDiv.style.display = 'none';

      let max = 0;
      let character = '';
      for (const [key, value] of Object.entries(answers)) {
        if (value > max) {
          max = value;
          character = key;
        }
      }

      const descriptions = {
        'Tomoe': {
          img: 'immagine/tomoe.jpg',
          text: 'Tomoe è la gufetta saggia e gentile. Ama i misteri e il silenzio della notte. Frase guida: "Non devi avere tutte le risposte, solo un posto sicuro dove iniziare a cercarle."'
        },
        'Yume': {
          img: 'immagine/yume.jpg',
          text: 'Yume è una cerbiatta empatica e sognatrice. Frase guida: "La dolcezza è una forma di coraggio".'
        },
        'Kitsu': {
          img: 'immagine/kitsu.jpg',
          text: 'Kitsu è una volpe brillante e furba, ama la tecnologia. Frase guida: "La curiosità è il mio superpotere!"'
        },
        'Miyon': {
          img: 'immagine/miyon.jpg',
          text: 'Miyon è una gattina nera misteriosa. Frase guida: "Non devi essere luminosa per brillare".'
        },
        'Miyun': {
          img: 'immagine/miyun.jpg',
          text: 'Miyun è una gattina bianca timida e sensibile. Frase guida: "Anche le anime tranquille brillano, solo in silenzio."'
        },
        'Iaia': {
          img: 'immagine/iaia.jpg',
          text: 'Iaia è un gatto siamese metà rosa e metà nero. Intuitiva, misteriosa, riflessiva. Frase guida: "Le cose preziose non fanno rumore."'
        },
        'Dodo': {
          img: 'immagine/dodo.jpg',
          text: 'Dodo è uno scoiattolino rosa gioioso e affettuoso. Frase guida: "La gioia è contagiosa, spargila ovunque!"'
        },
        'Kurob': {
          img: 'immagine/kurob.jpg',
          text: 'Kurob è un panda punk, ribelle ma tenero. Frase guida: "Anche chi graffia, può proteggere."'
        },
        'Anya': {
          img: 'immagine/anya.jpg',
          text: 'Anya è un’unicorno kawaii-goth misteriosa ma leale. Frase guida: "Essere diversi è la mia magia."'
        },
        'Mochi': {
          img: 'immagine/mochi.jpg',
          text: 'Mochi è un pipistrellino rosa dolce e vivace. Frase guida: "Piccolo ma potente!"'
        },
        'Nyu': {
          img: 'immagine/nyu.jpg',
          text: 'Nyu è un coniglietto lilla silenzioso e protettivo. Frase guida: "Il silenzio è un linguaggio segreto che pochi sanno ascoltare."'
        },
        'Toki': {
          img: 'immagine/toki.jpg',
          text: 'Toki è un procione razionale e ironico. Frase guida: "La logica è la mia bussola, ma so anche ridere."'
        }
      };

      const selected = descriptions[character];
      resultDiv.innerHTML = `
        <h2>Il tuo personaggio è ${character}!</h2>
        <img src="${selected.img}" alt="${character}" />
        <p>${selected.text}</p>
      `;
    }
  </script>
</body>
</html>
